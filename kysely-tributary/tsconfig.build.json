{
  "compilerOptions": {
    "baseUrl": "./",
    "lib": ["ES2020"],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/kysely-tributary.ts",
    "src/tributary-driver.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
