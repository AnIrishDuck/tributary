{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "tributary-client/*": ["../../../tributary-client/dist/*"],
      "scribe-react-listing/*": ["../scribe-react-listing/*"],
      "scribe-react-common/*": ["../scribe-react-common/*"],
      "@electric-sql/pglite/worker": ["../../../node_modules/@electric-sql/pglite/dist/worker/index"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "../../../tributary-client/tsconfig.json" }]
}
